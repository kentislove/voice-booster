{
  "manifest_version": 3,
  "name": "分頁音量放大神器 - 雙核心旗艦版",
  "version": "2.0.0",
  "description": "具備雙核心智慧切換引擎，完美相容一般網頁與受版權保護的影音平台（如網飛），提供防破音保護與等比例音量放大",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "分頁音量放大器（雙核心版）",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
